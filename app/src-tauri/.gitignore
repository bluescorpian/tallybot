# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Packaged sidecar binary (the `externalBin`) — a ~90 MB build artifact produced
# by `pnpm -C ../sidecar run build:binary` (esbuild + @yao-pkg/pkg), regenerated
# by `beforeBuildCommand`. Never commit it; keep the dir via .gitkeep.
/binaries/*
!/binaries/.gitkeep
