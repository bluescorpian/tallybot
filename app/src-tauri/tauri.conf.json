{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TallyBot",
  "version": "../package.json",
  "identifier": "com.tallybot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm -C sidecar run build:binary",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TallyBot",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tallybot-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/firmware/": "firmware/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NDgyQjE0NEI1NzdDNDQKUldSRWZGZExGQ3RJK1ZlMG5CTndDaUVPUW55RFdXV0JhZlN5WE0wSVQ3WURwT3h4Ti81Z0dobEUK",
      "endpoints": [
        "https://github.com/bluescorpian/tallybot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
