{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TallyBot",
  "version": "0.1.0",
  "identifier": "com.tallybot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm -C sidecar run build:binary",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TallyBot",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tallybot-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
